{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "settings.schema.json", "title": "Roadmap Settings", "type": "object",
  "required": ["title", "start_year", "end_year", "rows_per_swim_lane", "lanes_directory", "lane_order", "color_scheme", "color_schemes"],
  "properties": {
    "$schema": {"type": "string"}, "title": {"type": "string", "minLength": 1}, "subtitle": {"type": "string"},
    "start_year": {"type": "integer"}, "end_year": {"type": "integer"}, "rows_per_swim_lane": {"type": "integer", "minimum": 1},
    "lanes_directory": {"type": "string", "minLength": 1}, "lane_order": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "color_scheme": {"type": "string"},
    "color_schemes": {"type": "object", "additionalProperties": {"type": "object", "required": ["ui", "category_palette"],
      "properties": {
        "ui": {"type": "object", "required": ["background", "foreground", "muted", "line", "panel", "sub_lane", "bar_text"], "additionalProperties": {"type": "string"}},
        "category_palette": {"type": "array", "minItems": 1, "maxItems": 10, "items": {"type": "string"}}
      }, "additionalProperties": false}}
  }, "additionalProperties": false
}
